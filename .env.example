# AstrBot 裸机版本由 pyproject.toml 和 uv.lock 固定。
# 仅显式 pull/升级 NapCat 时获取镜像；生产环境建议改为已验证的版本或 digest。
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
# 已登录账号的 QQ 号，用于容器重建后尝试快速登录；首次扫码可以留空。
NAPCAT_ACCOUNT=
# 管理面板默认仅本机可访问；远程管理使用 SSH 隧道。
ASTRBOT_WEBUI_BIND=127.0.0.1
NAPCAT_WEBUI_BIND=127.0.0.1

DEVICE_STATUS_API_URL=http://127.0.0.1:5000/DeviceStatus
ELEC_API_BASE_URL=http://127.0.0.1:5051
# 低余额报警检查间隔，单位秒，最小60；不影响后端缓存和限流配置。
ELEC_ALERT_INTERVAL_SECONDS=3600
